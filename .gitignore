# Keep the example DOCUMENTS (and their reference PDFs) even though *.pdf and
# *.pltx are ignored above — but NOT the engine's scratch output, which is
# regenerated on every compile and only ever shows up as diff noise.
!examples/**/
!examples/**/*.tex
!examples/**/*.pltx
!examples/**/*.pdf
!examples/**/*.png
examples/**/*.build.tex
examples/**/*.aux
examples/**/*.log
examples/**/*.synctex.gz
examples/**/*.toc

# scratch / local dev files
prueba-*.*
# one-off helper scripts kept at the repo root while working on a document
/_*.py
/_*.mjs
/_*.js

# internal AI-assistant instructions (not part of the public project)
CLAUDE.md
.claude/
.github/copilot-instructions.md

